height = int(input("Enter diamond half-height (1 to 20): "))

if height < 1 or height > 20:
    print("Enter a number from 1 to 20.")
else:
    for row in range(1, height + 1):
        spaces = " " * (height - row)
        numbers = " ".join(str(number) for number in range(1, row + 1))
        print(spaces + numbers)

    for row in range(height - 1, 0, -1):
        spaces = " " * (height - row)
        numbers = " ".join(str(number) for number in range(1, row + 1))
        print(spaces + numbers)