units = int(input("Units consumed: "))

if units < 0:
    print("Units cannot be negative.")
else:
    if units <= 100:
        charge = units * 2
    elif units <= 200:
        charge = 100 * 2 + (units - 100) * 3
    else:
        charge = 100 * 2 + 100 * 3 + (units - 200) * 5

    fixed_charge = 50
    surcharge = charge * 0.05
    total = charge + fixed_charge + surcharge

    print("Energy charge: Rs.", charge)
    print("Fixed charge: Rs.", fixed_charge)
    print("Surcharge: Rs.", round(surcharge, 2))
    print("Total bill: Rs.", round(total, 2))