shift_count = int(input("Number of shifts: "))
shifts = []
valid = True

for i in range(shift_count):
    name = input(f"Employee for shift {i + 1}: ")
    start = int(input("Start hour (0 to 23): "))
    end = int(input("End hour (1 to 24): "))

    if start < 0 or end > 24 or start >= end:
        print("Invalid shift time.")
        valid = False
        break

    shifts.append((name, start, end))

if valid:
    conflict_found = False

    for i in range(len(shifts)):
        for j in range(i + 1, len(shifts)):
            name1, start1, end1 = shifts[i]
            name2, start2, end2 = shifts[j]

            if name1 == name2 and start1 < end2 and start2 < end1:
                print(
                    f"Conflict: {name1} has shifts "
                    f"{start1}-{end1} and {start2}-{end2}"
                )
                conflict_found = True

    if not conflict_found:
        print("No shift conflicts found.")